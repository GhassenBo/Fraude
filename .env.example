# ── Database ──
DB_USER=frauddetect
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ──
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING_HERE_USE_OPENSSL_RAND

# ── Stripe ──
STRIPE_API_KEY=YOUR_STRIPE_API_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXXXXX

# ── App ──
# Use comma-separated values to allow both www and non-www (CORS)
FRONTEND_URL=https://votredomaine.com,https://www.votredomaine.com
SPRING_PROFILES_ACTIVE=prod

# ── OpenAI ──
OPENAI_API_KEY=sk-...YOUR_OPENAI_KEY_HERE

# ── Email (verification d'adresse) ──
# Relais SMTP Brevo : https://app.brevo.com > SMTP & API > SMTP
# Laisser MAIL_HOST vide pour desactiver l'envoi (le lien est alors affiche dans les logs)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_BREVO_LOGIN
MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
MAIL_FROM=noreply@votredomaine.com
MAIL_FROM_NAME=FraudDetect

# ── Avis d'imposition ──
# URL du service officiel de verification d'avis d'imposition.
# A renseigner apres avoir verifie l'adresse exacte et les conditions
# d'utilisation ; laisser vide desactive simplement le lien dans l'interface.
AVIS_VERIFICATION_URL=

# ── 2D-DOC ──
# Verification cryptographique des cachets 2D-DOC des documents administratifs.
# DISABLED : aucune verification, statut NOT_VERIFIED.
# REMOTE_WITH_CACHE : liste de confiance de l'ANTS, puis annuaire de l'autorite.
TWO_DDOC_MODE=DISABLED
