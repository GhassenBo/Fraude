# ── Database ──
DB_USER=frauddetect
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ──
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING_HERE_USE_OPENSSL_RAND

# ── Stripe ──
STRIPE_API_KEY=YOUR_STRIPE_API_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXXXXX

# ── App ──
# Use comma-separated values to allow both www and non-www (CORS)
FRONTEND_URL=https://votredomaine.com,https://www.votredomaine.com
SPRING_PROFILES_ACTIVE=prod

# ── OpenAI ──
OPENAI_API_KEY=sk-...YOUR_OPENAI_KEY_HERE

# ── Email (verification d'adresse) ──
# Relais SMTP Brevo : https://app.brevo.com > SMTP & API > SMTP
# Laisser MAIL_HOST vide pour desactiver l'envoi (le lien est alors affiche dans les logs)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_BREVO_LOGIN
MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
MAIL_FROM=noreply@votredomaine.com
MAIL_FROM_NAME=FraudDetect
